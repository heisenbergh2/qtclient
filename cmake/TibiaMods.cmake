# Mods/: optional packs with mod.json — STATIC-linked into tibia tip.
#
#   client/mods/<name>/mod.json + CMakeLists.txt
#   -DQTCLIENT_LINKED_PACK=<pack>/client   # out-of-tree product (idleot-client)
#
# Runtime FS chrome: mods/<id>/ next to the tip (qml/overrides). Native C++ is
# linked at build time (qtclient_add_mod STATIC), not dlopen'd.

option(QTCLIENT_ENABLE_MODS "Discover and link mods/ packs into tibia" ON)
set(QTCLIENT_MODS_DIR "${TIBIA_ROOT}/client/mods" CACHE PATH "Directory containing client/mods/<name>/")
set(QTCLIENT_MODS "" CACHE STRING "Semicolon list of mod names to enable (empty = all non-template)")
set(QTCLIENT_LINKED_PACK "" CACHE PATH "External pack client/ dir to STATIC-link into tibia")

function(tibia_list_mods out_var)
  set(names "")
  if(EXISTS "${QTCLIENT_MODS_DIR}")
    file(GLOB _mod_dirs LIST_DIRECTORIES true "${QTCLIENT_MODS_DIR}/*")
    foreach(d IN LISTS _mod_dirs)
      if(IS_DIRECTORY "${d}" AND EXISTS "${d}/mod.json")
        get_filename_component(n "${d}" NAME)
        list(APPEND names "${n}")
      endif()
    endforeach()
  endif()
  set(${out_var} "${names}" PARENT_SCOPE)
endfunction()

function(tibia_mod_is_template mod_name out_var)
  string(SUBSTRING "${mod_name}" 0 1 _first)
  if(_first STREQUAL "_")
    set(${out_var} TRUE PARENT_SCOPE)
  else()
    set(${out_var} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(tibia_resolve_enabled_mods)
  set(enabled "")
  if(NOT QTCLIENT_ENABLE_MODS)
    set(QTCLIENT_ENABLED_MODS "${enabled}" PARENT_SCOPE)
    return()
  endif()
  tibia_list_mods(_all)
  if(QTCLIENT_MODS)
    foreach(n IN LISTS QTCLIENT_MODS)
      if(n IN_LIST _all)
        list(APPEND enabled "${n}")
      else()
        message(WARNING "qtclient mods: '${n}' listed in QTCLIENT_MODS but not found under ${QTCLIENT_MODS_DIR}")
      endif()
    endforeach()
  else()
    foreach(n IN LISTS _all)
      tibia_mod_is_template("${n}" _tmpl)
      if(NOT _tmpl)
        list(APPEND enabled "${n}")
      endif()
    endforeach()
  endif()
  set(QTCLIENT_ENABLED_MODS "${enabled}" PARENT_SCOPE)
endfunction()

function(tibia_add_mod_subdirectory mod_name)
  set(dir "${QTCLIENT_MODS_DIR}/${mod_name}")
  if(NOT EXISTS "${dir}/CMakeLists.txt")
    message(STATUS "qtclient mods: ${mod_name} has mod.json but no CMakeLists.txt — skip link")
    return()
  endif()
  # Optional make link → client/mods/<id> symlink to the same pack as
  # QTCLIENT_LINKED_PACK. Adding both creates duplicate qtclient_mod_<id>.
  if(QTCLIENT_LINKED_PACK)
    get_filename_component(_linked_abs "${QTCLIENT_LINKED_PACK}" ABSOLUTE)
    get_filename_component(_dir_abs "${dir}" ABSOLUTE)
    get_filename_component(_linked_real "${_linked_abs}" REALPATH)
    get_filename_component(_dir_real "${_dir_abs}" REALPATH)
    if(_dir_real STREQUAL _linked_real)
      message(STATUS "qtclient mods: ${mod_name} is QTCLIENT_LINKED_PACK — skip in-tree duplicate")
      return()
    endif()
  endif()
  message(STATUS "qtclient mods: enabling ${mod_name}")
  add_subdirectory("${dir}" "${CMAKE_CURRENT_BINARY_DIR}/mods/${mod_name}")
endfunction()

function(tibia_add_enabled_mods)
  tibia_resolve_enabled_mods()
  foreach(_qt_mod IN LISTS QTCLIENT_ENABLED_MODS)
    set(_brand "${QTCLIENT_MODS_DIR}/${_qt_mod}/brand.cmake")
    if(EXISTS "${_brand}")
      include("${_brand}")
    endif()
    tibia_add_mod_subdirectory("${_qt_mod}")
  endforeach()

  # Out-of-tree product pack (idleot-client/client) — same STATIC link path.
  if(QTCLIENT_ENABLE_MODS AND QTCLIENT_LINKED_PACK)
    get_filename_component(_linked "${QTCLIENT_LINKED_PACK}" ABSOLUTE)
    if(EXISTS "${_linked}/CMakeLists.txt" AND EXISTS "${_linked}/mod.json")
      message(STATUS "qtclient mods: QTCLIENT_LINKED_PACK=${_linked}")
      set(_brand "${_linked}/brand.cmake")
      if(EXISTS "${_brand}")
        include("${_brand}")
      endif()
      add_subdirectory("${_linked}" "${CMAKE_CURRENT_BINARY_DIR}/mods/_linked_pack")
    else()
      message(FATAL_ERROR "QTCLIENT_LINKED_PACK=${QTCLIENT_LINKED_PACK} needs CMakeLists.txt + mod.json")
    endif()
  endif()

  if(QTCLIENT_ENABLE_MODS AND QTCLIENT_ENABLED_MODS STREQUAL "" AND NOT QTCLIENT_LINKED_PACK)
    message(STATUS "qtclient mods: enabled, none discovered (stock CIP)")
  endif()
  set(TIBIA_PRODUCT_NAME "${TIBIA_PRODUCT_NAME}" PARENT_SCOPE)
  set(TIBIA_PRODUCT_ORG "${TIBIA_PRODUCT_ORG}" PARENT_SCOPE)
  set(TIBIA_PRODUCT_URL "${TIBIA_PRODUCT_URL}" PARENT_SCOPE)
  set(TIBIA_DEFAULT_CDN "${TIBIA_DEFAULT_CDN}" PARENT_SCOPE)
  set(TIBIA_CLIENT_PACKAGE_DIR "${TIBIA_CLIENT_PACKAGE_DIR}" PARENT_SCOPE)
  if(DEFINED TIBIA_PRODUCT_BUNDLE_ID)
    set(TIBIA_PRODUCT_BUNDLE_ID "${TIBIA_PRODUCT_BUNDLE_ID}" PARENT_SCOPE)
  endif()
  set(QTCLIENT_ENABLED_MODS "${QTCLIENT_ENABLED_MODS}" PARENT_SCOPE)
endfunction()

# Must run from the directory that created target `tibia` (after
# tibia_add_enabled_mods). Stages mods/<id>/ FS chrome next to the tip.
function(tibia_apply_linked_pack_staging)
  if(NOT TARGET tibia)
    message(FATAL_ERROR "tibia_apply_linked_pack_staging: target tibia missing")
  endif()
  get_property(_stages GLOBAL PROPERTY QTCLIENT_MOD_TIP_STAGE)
  foreach(_entry IN LISTS _stages)
    string(REPLACE "|" ";" _parts "${_entry}")
    list(GET _parts 0 _mod_id)
    list(GET _parts 1 _outdir)
    add_custom_command(TARGET tibia POST_BUILD
      COMMAND ${CMAKE_COMMAND} -E rm -rf "$<TARGET_FILE_DIR:tibia>/mods/${_mod_id}"
      COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:tibia>/mods/${_mod_id}"
      COMMAND ${CMAKE_COMMAND} -E copy_directory "${_outdir}" "$<TARGET_FILE_DIR:tibia>/mods/${_mod_id}"
      COMMAND ${CMAKE_COMMAND} -E rm -rf "$<TARGET_FILE_DIR:tibia>/mods/${_mod_id}/lib"
      COMMAND ${CMAKE_COMMAND} -E rm -rf "$<TARGET_FILE_DIR:tibia>/mods/${_mod_id}/native"
      COMMENT "install ${_mod_id} FS pack next to tip")
  endforeach()
endfunction()
